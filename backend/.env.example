# NexSMS Backend Environment
PORT=4000
NODE_ENV=development

# Database
DATABASE_URL=postgres://nexsms:nexsms_dev_password@localhost:5432/nexsms

# Redis
REDIS_URL=redis://localhost:6379

# Auth
JWT_SECRET=change-me-in-production-nexsms-secret-key
JWT_EXPIRES_IN=7d
JWT_REFRESH_SECRET=change-me-refresh-secret-nexsms
JWT_REFRESH_EXPIRES_IN=30d

# CORS
CORS_ORIGIN=http://localhost:5173

# SMTP (optional, for password reset emails)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
